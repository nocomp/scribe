# nginx.conf — exemple reverse proxy SCRIBE (HTTPS)
# Prérequis : certbot / Let's Encrypt

server {
    listen 80;
    server_name scribe.votre-etablissement.fr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name scribe.votre-etablissement.fr;

    ssl_certificate     /etc/letsencrypt/live/scribe.votre-etablissement.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scribe.votre-etablissement.fr/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Taille max pour les pièces jointes
    client_max_body_size 50M;

    location / {
        proxy_pass         http://scribe:8000;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;

        # WebSocket (pour les futures fonctions temps réel)
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
    }
}
