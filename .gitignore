lancer_*_prod.sh
*_PROD.bat

# Clinique Saint-Benoît de Montrelay (démo 2)
config_csbm*.xml
LANCER_CSBM.bat

# ─── SECRETS — AUCUN DE CES FICHIERS NE DOIT FUITER ─────────────────
.env
.env.*
