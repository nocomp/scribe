# ─── SCRIBE — .gitignore pour release publique ────────────────────────
# Tout ce qui ne doit JAMAIS finir sur GitHub est filtré ici.
# Ton workspace local garde tout pour le dev ; seul ce qui passe ce
# filtre est inclus dans les zips _public et les commits Git.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
.pyre/
.pytype/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.egg
build/
dist/
pip-log.txt
pip-delete-this-directory.txt

# Environnements virtuels
venv/
env/
.venv/
.env/
ENV/

# Bases de données SQLite (état runtime)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
scribe.db
scribe_*.db
exo_*.db

# Logs et fichiers runtime
*.log
logs/
*.pid
*.out
*.err

# Fichiers JSON runtime du collecteur (état d'exercice)
collecteur/collecteur_admin.json
collecteur/collecteur_transferts.json
collecteur/collecteur_incidents.json
collecteur/collecteur_decisions.json
collecteur/collecteur_sessions.json
collecteur/etablissements.json
collecteur_exercice/collecteur_exo_*.json
collecteur_exercice/etablissements_exo.json
collecteur_exercice/messages_inter_exo.json

# Archives et exports utilisateur
archives/
exports/
uploads/
*.zip
!docs/**/*.zip

# État i18n runtime
app/lang/_current.json

# Config statique générée à l'init (contient secrets fédération)
app/static/config.js

